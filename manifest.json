{
  "manifest_version": 3,
  "name": "Design Extractor",
  "version": "1.0.0",
  "description": "Scans the currently active tab, extracts real design tokens (colors, typography, spacing, radii, shadows, breakpoints), and lets you download design.md.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Extract Design System Tokens",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
